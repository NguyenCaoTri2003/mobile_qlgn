{
  "expo": {
    "name": "Nhị Gia Logistics",
    "slug": "nhi-gia-logistics",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo/app-icon-1024.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/logo/app-icon-1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nhigia.logistics",
      "infoPlist": {
        "NSLocationAlwaysAndWhenInUseUsageDescription": "App cần vị trí để theo dõi đơn hàng ngay cả khi app đang chạy nền",
        "NSLocationWhenInUseUsageDescription": "App cần vị trí để theo dõi đơn hàng",
        "NSLocationAlwaysUsageDescription": "App cần truy cập vị trí liên tục để cập nhật trạng thái giao hàng"
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo/app-icon-1024.png",
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nhigia.logistics",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/logo/favicon.png"
    },
    "plugins": ["expo-sharing"],
    "extra": {
      "eas": {
        "projectId": "f13b2926-a536-4ed1-bbe5-ee852733647e"
      }
    }
  }
}
